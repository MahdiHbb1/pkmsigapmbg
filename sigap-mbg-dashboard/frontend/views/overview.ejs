<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
      <div class="nav-brand">
        <h1>SIGAP MBG</h1>
        <span class="nav-subtitle">Food Freshness Monitoring</span>
      </div>
      <ul class="nav-menu">
        <li><a href="/overview" class="active">Overview</a></li>
        <li><a href="/alerts">Alerts</a></li>
      </ul>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <h2>Device Overview</h2>
      <p class="text-muted">Monitoring semua unit SIGAP MBG</p>
    </div>

    <!-- Stats Summary -->
    <div class="stats-summary" id="stats-summary" style="display: none;">
      <div class="stat-card stat-card-neutral">
        <div class="stat-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </div>
        <div class="stat-content">
          <div class="stat-value" id="stat-total">0</div>
          <div class="stat-label">Total Devices</div>
        </div>
      </div>
      <div class="stat-card stat-card-success">
        <div class="stat-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="stat-content">
          <div class="stat-value" id="stat-layak">0</div>
          <div class="stat-label">Layak</div>
        </div>
      </div>
      <div class="stat-card stat-card-warning">
        <div class="stat-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
        <div class="stat-content">
          <div class="stat-value" id="stat-perlu-diperiksa">0</div>
          <div class="stat-label">Perlu Diperiksa</div>
        </div>
      </div>
      <div class="stat-card stat-card-danger">
        <div class="stat-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
          </svg>
        </div>
        <div class="stat-content">
          <div class="stat-value" id="stat-tidak-layak">0</div>
          <div class="stat-label">Tidak Layak</div>
        </div>
      </div>
    </div>

    <div id="loading" class="loading">Loading devices...</div>
    <div id="error" class="error-message" style="display: none;"></div>
    
    <div id="devices-grid" class="devices-grid">
      <!-- Device cards will be inserted here by JavaScript -->
    </div>

    <div class="last-update">
      Last updated: <span id="last-update-time">-</span>
    </div>
  </main>

  <footer class="footer">
    <p>&copy; 2026 PKM-KC SIGAP MBG - Universitas Negeri Semarang</p>
  </footer>

  <script src="/js/overview.js"></script>
</body>
</html>
